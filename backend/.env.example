# ── Certificado Digital ────────────────────────────────────────────────────────
# Ruta al archivo .pfx (PKCS#12) o al par .pem (cert + key por separado)
CERT_PATH=certs/empresa.pfx
CERT_PASSWORD=tu_password_aqui

# Si usas .pem por separado en lugar de .pfx:
# CERT_PEM_PATH=certs/cert.pem
# KEY_PEM_PATH=certs/key.pem

# ── Datos de la empresa ────────────────────────────────────────────────────────
EMPRESA_RUT=76123456-7
EMPRESA_RAZON_SOCIAL=Empresa Agrícola Surco SpA
EMPRESA_GIRO=Producción agrícola y exportación de fruta
EMPRESA_DIRECCION=Av. Principal 123, Curicó
EMPRESA_COMUNA=Curicó
EMPRESA_CIUDAD=Curicó
EMPRESA_REGION=Maule

# ── Entorno SII ────────────────────────────────────────────────────────────────
# "certificacion" para pruebas | "produccion" para ambiente real
SII_AMBIENTE=certificacion

# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./surco_sii.db
